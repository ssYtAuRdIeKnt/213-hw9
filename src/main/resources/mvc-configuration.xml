<?xml version="1.0" encoding="UTF-8"?>
<!--
    XML version of the same Spring MVC configuration (section 5 of the tutorial).
    It is NOT loaded by the application - the Java config in WebConfig is used instead.
    It is kept here to show that both styles describe the same setup.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context
        http://www.springframework.org/schema/context/spring-context.xsd
        http://www.springframework.org/schema/mvc
        http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- same as @ComponentScan: find @Controller classes -->
    <context:component-scan base-package="ua.edu.auk.sdt213.hw9"/>

    <!-- same as @EnableWebMvc -->
    <mvc:annotation-driven/>

    <!-- same as addViewControllers(): "/" -> index view -->
    <mvc:view-controller path="/" view-name="index"/>

    <!-- same as the viewResolver() bean -->
    <bean id="viewResolver"
          class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/view/"/>
        <property name="suffix" value=".jsp"/>
    </bean>
</beans>
